{
  "info": {
    "name": "Car Dealership Integration",
    "_postman_id": "b8f8a7b8-96ff-4a51-9f8a-4c5f8221a1f1",
    "description": "Simple frontend-backend integration checks via API endpoints used by frontend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Root health text",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Versioned health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('body has version v1', function () {",
              "  var json = pm.response.json();",
              "  pm.expect(json.status).to.eql('ok');",
              "  pm.expect(json.version).to.eql('v1');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Gateway/Integration status",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/integrations/messaging/status"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('body includes bus/cache status', function () {",
              "  var json = pm.response.json();",
              "  pm.expect(json.status).to.eql('ok');",
              "  pm.expect(json.bus).to.be.an('object');",
              "  pm.expect(json.cache).to.be.an('object');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
