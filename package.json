{
  "name": "car-dealership",
  "version": "1.0.0",
  "description": "Car Dealership: React, Express, MySQL (phpMyAdmin), MongoDB",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node backend/index.js",
    "dev": "nodemon backend/index.js",
    "lint": "node --check backend/index.js && node --check backend/services/authService.js && node --check backend/lib/metrics.js && node --check backend/lib/circuitBreaker.js",
    "test": "jest tests --runInBand --detectOpenHandles --testPathIgnorePatterns=testcontainers.environment.integration.test.js",
    "test:coverage": "jest tests --runInBand --coverage --testPathIgnorePatterns=testcontainers.environment.integration.test.js",
    "test:integration:newman": "newman run tests/postman/Car-Dealership.postman_collection.json -e tests/postman/local.postman_environment.json",
    "test:integration:testcontainers": "jest tests/testcontainers.environment.integration.test.js --runInBand",
    "test:e2e:open": "cypress open",
    "test:e2e:run": "cypress run",
    "test:performance": "node tests/performance/load-test.js",
    "test:performance:1k": "node tests/performance/load-test.js --connections 1000 --duration 30 --max-latency 1200 --min-rps 50",
    "qa:full": "npm run test:coverage && npm run test:e2e:run && npm run test:performance"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rionkomoni/Car-Dealership.git"
  },
  "keywords": [
    "car",
    "dealership",
    "react",
    "express",
    "mysql",
    "phpmyadmin",
    "mongodb",
    "fullstack"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/rionkomoni/Car-Dealership/issues"
  },
  "homepage": "https://github.com/rionkomoni/Car-Dealership#readme",
  "dependencies": {
    "amqplib": "^1.0.3",
    "apicache": "^1.6.3",
    "bcryptjs": "^3.0.2",
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "express-status-monitor": "^1.3.4",
    "helmet": "^8.1.0",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.3.3",
    "multer": "^2.1.1",
    "mysql2": "^3.20.0",
    "nodemailer": "^8.0.7",
    "pdfkit": "^0.18.0",
    "prom-client": "^15.1.3",
    "redis": "^5.12.1",
    "sequelize": "^6.37.8",
    "swagger-ui-express": "^5.0.1",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "cypress": "^14.5.4",
    "jest": "^30.3.0",
    "newman": "^6.2.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "testcontainers": "^11.14.0"
  }
}
