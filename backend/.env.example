# Kopjo si backend/.env (lokal) ose vendos të njëjtat vlera në Render Dashboard.
# Burimi i së vërtetës për MySQL: Railway → MySQL → Connect / Variables

PORT=5000

MYSQL_HOST=your-host.proxy.rlwy.net
MYSQL_PORT=18396
MYSQL_USER=root
MYSQL_PASSWORD=your-railway-mysql-password
MYSQL_DB=railway
MYSQL_AUTO_CREATE_DB=false

MONGO_URI=mongodb://USER:PASSWORD@host1,host2,host3/cardealership?ssl=true&authSource=admin&retryWrites=true&w=majority

JWT_SECRET=ndrysho-kete-me-string-te-gjate-random-32plus

ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=12345678
MANAGER_EMAIL=manager@gmail.com
MANAGER_PASSWORD=12345678

EMAIL_PROVIDER=smtp
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-mailtrap-user
SMTP_PASS=your-mailtrap-pass
SMTP_SECURE=false
SMTP_FROM="Car Dealership <no-reply@local.test>"

EXPOSE_PASSWORD_RESET_LINK=true
EXPOSE_ACTIVATION_LINK=true

# --- Render (api.cardealership.fit) — ndryshimet e nevojshme ---
# PORT=10000
# NODE_ENV=production
# FORCE_HTTPS=true
# REACT_APP_API_URL=https://api.cardealership.fit
# (MySQL + MONGO_URI + JWT_SECRET: të njëjtat si më sipër, nga Railway/Atlas)

# --- Vercel (frontend) — vetëm 1 variabël ---
# REACT_APP_API_URL=https://api.cardealership.fit
